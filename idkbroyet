-- Load Rayfield
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Flip Tester | Dev Tools",
    LoadingTitle = "Flip Controls",
    LoadingSubtitle = "Always Heads Mode",
})

local Tab = Window:CreateTab("Flip", 4483362458)

local sendRoll = game:GetService("ReplicatedStorage"):WaitForChild("sendRoll")
local sendRollResults = game:GetService("ReplicatedStorage"):WaitForChild("sendRollResults")

local alwaysHeads = false

-----------------------------------------------------------------------
-- SEND HEADS
-----------------------------------------------------------------------
local function SendHeads()
    -- Your game uses this exactly:
    sendRoll:InvokeServer("Heads")
    sendRollResults:InvokeServer("Heads")
end

-----------------------------------------------------------------------
-- BUTTON: FORCE HEADS ONCE
-----------------------------------------------------------------------
Tab:CreateButton({
    Name = "Force HEADS (One Flip)",
    Callback = function()
        SendHeads()
    end
})

-----------------------------------------------------------------------
-- TOGGLE: ALWAYS HEADS
-----------------------------------------------------------------------
Tab:CreateToggle({
    Name = "Always Heads Mode",
    CurrentValue = false,
    Callback = function(state)
        alwaysHeads = state
        while alwaysHeads do
            SendHeads() -- keeps sending Heads no matter what
            task.wait(0.1) -- you can increase or decrease speed
        end
    end
})
