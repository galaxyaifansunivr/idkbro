-- Load Rayfield
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Flip Tester | Dev Tools",
    LoadingTitle = "Flip Controls",
    LoadingSubtitle = "Force Heads / Tails",
})

local Tab = Window:CreateTab("Flip", 4483362458)

local sendRoll = game:GetService("ReplicatedStorage"):WaitForChild("sendRoll")

-- FORCE HEADS
Tab:CreateButton({
    Name = "Force HEADS",
    Callback = function()
        sendRoll:InvokeServer("Heads")
    end
})

-- FORCE TAILS
Tab:CreateButton({
    Name = "Force TAILS",
    Callback = function()
        sendRoll:InvokeServer("Tails")
    end
})

-- AUTO HEADS MODE
local autoHeads = false
Tab:CreateToggle({
    Name = "Auto Heads",
    CurrentValue = false,
    Callback = function(state)
        autoHeads = state
        while autoHeads do
            sendRoll:InvokeServer("Heads")
            task.wait(0.1)
        end
    end
})

-- AUTO TAILS MODE
local autoTails = false
Tab:CreateToggle({
    Name = "Auto Tails",
    CurrentValue = false,
    Callback = function(state)
        autoTails = state
        while autoTails do
            sendRoll:InvokeServer("Tails")
            task.wait(0.1)
        end
    end
})
