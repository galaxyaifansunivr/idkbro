
-- load Rayfield from OFFICIAL WEBSITE (not GitHub)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- create window
local Window = Rayfield:CreateWindow({
    Name = "Global Chat",
    LoadingTitle = "Loading..."
})

-- button to send "global"
Window:CreateButton({
    Name = "Send GLOBAL",
    Callback = function()
        print("Button clicked")

        local TextChatService = game:GetService("TextChatService")

        -- NEW Roblox chat system
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:SendAsync("global")
            else
                warn("RBXGeneral not found")
            end
        else
            -- OLD chat system
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local event = ReplicatedStorage:FindFirstChild("SayMessageRequest")
            if event then
                event:FireServer("global", "All")
            else
                warn("SayMessageRequest not found")
            end
        end
    end
})

print("UI LOADED")
