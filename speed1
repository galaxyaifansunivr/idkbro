-- THE FORGE | Rayfield UI (Executor Only)

-- Load Rayfield
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- Window
local Window = Rayfield:CreateWindow({
    Name = "⚒ THE FORGE | Angel Roll",
    LoadingTitle = "THE FORGE",
    LoadingSubtitle = "Rayfield UI",
    ConfigurationSaving = {
        Enabled = false
    }
})

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- States
local AutoMine = false
local AutoKill = false

--------------------------------------------------
-- TAB
--------------------------------------------------
local Tab = Window:CreateTab("Automation", 4483362458)

Tab:CreateToggle({
    Name = "Auto Mine Pebble",
    CurrentValue = false,
    Callback = function(v)
        AutoMine = v
    end
})

Tab:CreateToggle({
    Name = "Auto Kill Mobs",
    CurrentValue = false,
    Callback = function(v)
        AutoKill = v
    end
})

--------------------------------------------------
-- CORE LOOP
--------------------------------------------------
RunService.Heartbeat:Connect(function()
    -- AUTO MINE (Pebble)
    if AutoMine then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v.Name == "Pebble" then
                -- ProximityPrompt mining
                for _, p in pairs(v:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then
                        fireproximityprompt(p)
                    end
                end
            end
        end
    end

    -- AUTO KILL (Any mob with Humanoid)
    if AutoKill then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                local hum = v.Humanoid
                if hum.Health > 0 then
                    hum.Health = 0
                end
            end
        end
    end
end)
